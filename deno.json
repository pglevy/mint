{
  "name": "mint-cli",
  "version": "0.2.0",
  "exports": "./main.ts",
  "tasks": {
    "start": "deno run --allow-net=raw.githubusercontent.com main.ts",
    "test": "deno test --allow-read --allow-run --allow-env --allow-net=raw.githubusercontent.com",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check main.ts",
    "install": "deno install -f --allow-net=raw.githubusercontent.com --allow-env --name mint main.ts"
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@1",
    "@std/assert": "jsr:@std/assert@1"
  },
  "fmt": {
    "exclude": ["gitignore/"]
  },
  "lint": {
    "exclude": ["gitignore/"]
  }
}
